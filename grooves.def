; grooves.def

; this is where all the default grooves go.
; this file can be overriden by a character by adding grooves to a character's .def file.

; enabled is 1 by default so you don't need to have it when adding grooves.

; STANDARD FORMAT
; [Groovedef <Groove Name>]

;[Groovedef Name]
;map_name = groove_style
;map_value = 1
;enabled = 0
;color = 255,255,255,255

;[groovedef X-ISM]
;map_name = groove_style
;map_value = 2
;enabled = 1

; For toukachan5900's characters:

[groovedef X-ISM]
map_name = my_ism_selector_map
map_value = 0
enabled = 1
color = 255, 0, 0

[groovedef Z-ISM]
map_name = my_ism_selector_map
map_value = 1
enabled = 1
color = 0, 255, 0

[groovedef V-ISM]
map_name = my_ism_selector_map
map_value = 2
enabled = 1
color = 0, 0, 255
