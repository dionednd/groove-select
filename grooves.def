; grooves.def

; this is where all the default grooves go.
; this file can be overriden by a character by adding grooves to a character's .def file.

; map names must be lowercase

; enabled is 1 by default so you don't need to have it when adding grooves.

; STANDARD FORMAT

;[Groove Name]
;map_name = groove_style
;map_value = 1
;enabled = 0

;[MARX-ISM]
;map_name = groove_style
;map_value = 2
;enabled = 1

; GROOVE STYLE FORMAT (old)

;[Groove Style]
;name = Groove Name
;map_name = groove_style
;map_value = 3
;enabled = 1

;[Groove Style]
;name = TENDERN-ISM
;map_name = groove_style
;map_value = 3
;enabled = 1